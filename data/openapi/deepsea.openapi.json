  "components": {
    "schemas": {
      "CreateCurrencyPairRequest": {
        "required": [
          "sourceCurrency",
          "destinationCurrency"
        ],
        "type": "object",
        "properties": {
          "sourceCurrency": {
            "type": "string"
          },
          "destinationCurrency": {
            "type": "string"
          },
          "syncEnabled": {
            "type": "boolean"
          }
        }
      },
      "CurrencyPairBulkImportItem": {
        "required": [
          "sourceCurrency",
          "destinationCurrency"
        ],
        "type": "object",
        "properties": {
          "sourceCurrency": {
            "type": "string"
          },
          "destinationCurrency": {
            "type": "string"
          },
          "syncEnabled": {
            "type": "boolean"
          }
        }
      },
      "CurrencyPairBulkImportRequest": {
        "type": "object",
        "properties": {
          "currencyPairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyPairBulkImportItem"
            }
          }
        }
      },
      "CurrencyPairBulkImportStatus": {
        "required": [
          "status",
          "sourceCurrency",
          "destinationCurrency"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ImportStatus"
          },
          "sourceCurrency": {
            "type": "string"
          },
          "destinationCurrency": {
            "type": "string"
          }
        }
      },
      "CurrencyPairDto": {
        "required": [
          "sourceCurrency",
          "destinationCurrency"
        ],
        "type": "object",
        "properties": {
          "syncEnabled": {
            "type": "boolean",
            "description": "Gets or sets the SyncEnabled."
          },
          "sourceCurrency": {
            "type": "string",
            "description": "Gets or sets the SourceCurrency."
          },
          "destinationCurrency": {
            "type": "string",
            "description": "Gets or sets the DestinationCurrency."
          },
          "id": {
            "type": "string",
            "description": "Gets or sets the Id.",
            "format": "uuid"
          }
        },
        "description": "Generated DTO for entity CurrencyPair."
      },
      "ImportStatus": {
        "enum": [
          "success",
          "existed"
        ]
      },
      "MidRateDto": {
        "required": [
          "sourceCurrency",
          "destinationCurrency"
        ],
        "type": "object",
        "properties": {
          "rate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Gets or sets the Rate.",
            "format": "double"
          },
          "sourceCurrency": {
            "type": "string",
            "description": "Gets or sets the SourceCurrency."
          },
          "destinationCurrency": {
            "type": "string",
            "description": "Gets or sets the DestinationCurrency."
          },
          "id": {
            "type": "string",
            "description": "Gets or sets the Id.",
            "format": "uuid"
          }
        },
        "description": "Generated DTO for entity MidRate."
      },
      "PagedResultOfCurrencyPairDto": {
        "type": "object",
        "properties": {
          "queryable": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyPairDto"
            }
          },
          "currentPage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rowCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PagedResultOfMidRateDto": {
        "type": "object",
        "properties": {
          "queryable": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MidRateDto"
            }
