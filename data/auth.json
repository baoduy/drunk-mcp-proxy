{
  "defaultProvider": "auth0",
  "auth0": {
    "domain": "$AUTH0_DOMAIN",
    "client_id": "$AUTH0_CLIENT_ID",
    "client_secret": "$AUTH0_CLIENT_SECRET",
    "audience": null,
    "scopes": [],
    "grant_type": "client_credentials"
  },
  "aws": {
    "access_key_id": "$AWS_ACCESS_KEY_ID",
    "secret_access_key": "$AWS_SECRET_ACCESS_KEY",
    "region": "$AWS_REGION",
    "session_token": null,
    "role_arn": null
  },
  "azure": {
    "client_id": "$AZURE_CLIENT_ID",
    "client_secret": "$AZURE_CLIENT_SECRET",
    "tenant_id": "$AZURE_TENANT_ID",
    "token_url": null,
    "issuer": null,
    "scopes": []
  },
  "descope": {
    "project_id": "$DESCOPE_PROJECT_ID",
    "public_key": "$DESCOPE_PUBLIC_KEY",
    "scopes": []
  },
  "discord": {
    "client_id": "$DISCORD_CLIENT_ID",
    "client_secret": "$DISCORD_CLIENT_SECRET",
    "bot_token": "$DISCORD_BOT_TOKEN",
    "scopes": [],
    "redirect_uri": null
  },
  "github": {
    "client_id": "$GITHUB_CLIENT_ID",
    "client_secret": "$GITHUB_CLIENT_SECRET",
    "scopes": [
      "user:email"
    ],
    "redirect_uri": null
  },
  "google": {
    "client_id": "$GOOGLE_CLIENT_ID",
    "client_secret": "$GOOGLE_CLIENT_SECRET",
    "project_id": "$GOOGLE_PROJECT_ID",
    "scopes": [
      "openid",
      "email",
      "profile"
    ],
    "redirect_uri": null
  },
  "inMemory": {
    "users": {
      "user1": "password1",
      "user2": "password2"
    }
  },
  "introspection": {
    "introspection_url": "$TOKEN_INTROSPECTION_URL",
    "client_id": "$TOKEN_INTROSPECTION_CLIENT_ID",
    "client_secret": "$TOKEN_INTROSPECTION_CLIENT_SECRET"
  },
  "jwt": {
    "secret_key": "$JWT_SECRET_KEY",
    "algorithm": "HS256",
    "issuer": null,
    "audience": null
  },
  "oci": {
    "user_ocid": "$OCI_USER_OCID",
    "tenancy_ocid": "$OCI_TENANCY_OCID",
    "api_key": "$OCI_API_KEY",
    "fingerprint": "$OCI_FINGERPRINT",
    "region": "us-phoenix-1"
  },
  "scalekit": {
    "client_id": "$SCALEKIT_CLIENT_ID",
    "client_secret": "$SCALEKIT_CLIENT_SECRET",
    "environment_url": "$SCALEKIT_ENVIRONMENT_URL",
    "scopes": []
  },
  "supabase": {
    "project_url": "$SUPABASE_PROJECT_URL",
    "api_key": "$SUPABASE_API_KEY",
    "scopes": []
  },
  "workos": {
    "api_key": "$WORKOS_API_KEY",
    "client_id": "$WORKOS_CLIENT_ID",
    "organization_id": null,
    "scopes": []
  }
}