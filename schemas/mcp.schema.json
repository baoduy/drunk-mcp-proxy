{
  "$id": "https://gofastmcp.com/public/schemas/mcp-proxy.json/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Proxy Configuration",
  "type": "object",
  "properties": {
    "mcpServers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "timeout": {
            "type": "integer",
            "minimum": 0
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "path": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "enum": [
              "http",
              "sse",
              "streamable-http",
              "stdio"
            ],
            "default": "http"
          }
        },
        "required": [
          "transport"
        ],
        "anyOf": [
          {
            "required": [
              "command"
            ],
            "properties": {
              "transport": {
                "const": "stdio"
              }
            }
          },
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "path"
            ]
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "mcpServers"
  ],
  "additionalProperties": true
}
