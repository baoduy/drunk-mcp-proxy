{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/baoduy/drunk-mcp-proxy/schemas/proxies.schema.json",
  "title": "Dynamic Proxies Configuration",
  "description": "Configuration schema for dynamically added MCP proxy servers",
  "type": "object",
  "properties": {
    "proxies": {
      "type": "array",
      "description": "List of dynamically added proxy servers",
      "items": {
        "type": "object",
        "description": "Proxy server configuration",
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique name identifier for the proxy",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "minLength": 1,
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "description": "The URL of the MCP server to proxy",
            "format": "uri",
            "pattern": "^https?://"
          },
          "transport": {
            "type": "string",
            "description": "Transport protocol to use",
            "enum": ["http", "sse", "stdio"],
            "default": "http"
          }
        },
        "required": ["name", "url", "transport"],
        "additionalProperties": false
      }
    }
  },
  "required": ["proxies"],
  "additionalProperties": false
}
