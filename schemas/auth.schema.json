{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/baoduy/drunk-mcp-proxy/schemas/auth.schema.json",
  "title": "Authentication Configuration",
  "description": "Configuration schema for API key authentication",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Whether authentication is enabled",
      "default": false
    },
    "api_keys": {
      "type": "object",
      "description": "Map of client names to their hashed API keys",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "string",
          "description": "SHA-256 hash of the API key",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["enabled", "api_keys"],
  "additionalProperties": false
}
