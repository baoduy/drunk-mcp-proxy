{
	"servers": {
		"microsoft/markitdown": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"markitdown-mcp@0.0.1a4"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"io.github.upstash/context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@upstash/context7-mcp@1.0.31"
			],
			"env": {
				"CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.31"
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		},
		"drawio-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@drawio/mcp@latest"
			],
		},
		"cognitionai/deepwiki": {
			"type": "http",
			"url": "https://mcp.deepwiki.com/mcp",
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},

		"drunk-mcp": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"./dist/drunk_ai_client/drunk_ai_client-0.1.0-py3-none-any.whl",
				"drunk_ai_client"
			],
			"env": {
				"API_URL": "http://0.0.0.0:9123/locals/mcp/",
				"API_KEY": "518104e2-865e-4eb2-a050-caec8d67125f",
				"SKILL_DIR": "client-sample/skills",
				"AGENTS_DIR": "client-sample/agents"
			}
		}
	},
	"inputs": [
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "Context7 API key for authentication",
			"password": true
		}
	]
}