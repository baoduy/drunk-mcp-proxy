# ============================================================================
# MCP PROXY SERVER - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in the required values for your environment
# This file contains example/placeholder values - do NOT use in production!

# ------------------------------------
# Server Configuration
# ------------------------------------
# Enable request header validation (Authorization header must not be empty)
FASTMCP_AUTH_ENABLED=false

# Directory containing MCP server configuration files (*.mcp.json)
FASTMCP_CONFIG_DIR=data

# Server host binding (0.0.0.0 = all interfaces)
FASTMCP_HOST=0.0.0.0

# Log level controls verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FASTMCP_LOG_LEVEL=INFO

# Route prefix for LLM proxy endpoints
FASTMCP_LLM_ROUTE_PREFIX=/llm/v1

# Server port number (1-65535)
FASTMCP_PORT=9123

# Server name for logging and health checks
FASTMCP_SERVER_NAME=mcp-proxy-server

# Transport protocol (http, sse, streamable-http)
FASTMCP_SERVER_TRANSPORT="streamable-http"

# Server version string
FASTMCP_SERVER_VERSION=1.0.0

# Enable stateless HTTP mode (useful for serverless/cloud deployments)
FASTMCP_STATELESS_HTTP=true

# ------------------------------------
# CORS Configuration
# ------------------------------------
# CORS values are comma-separated lists
# Allow credentials in CORS responses (true or false)
FASTMCP_CORS_ALLOW_CREDENTIALS=false
# Allowed request headers
FASTMCP_CORS_ALLOW_HEADERS=mcp-protocol-version,mcp-session-id,Authorization,Content-Type
# Allowed HTTP methods
FASTMCP_CORS_ALLOW_METHODS=GET,POST
# Allowed origins for CORS requests (* = all origins)
FASTMCP_CORS_ALLOW_ORIGINS=*
# Headers exposed in responses
FASTMCP_CORS_EXPOSE_HEADERS=mcp-session-id
# Max age (seconds) for CORS preflight caching
FASTMCP_CORS_MAX_AGE=3600

# ------------------------------------
# Rate Limit Configuration
# ------------------------------------
FASTMCP_RATE_LIMIT_ENABLED=true
FASTMCP_RATE_LIMIT_REQUESTS=60
FASTMCP_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------
# OAuth Configuration
# ------------------------------------
# Fernet encryption key for OAuth token storage (required if using OAuth)
FASTMCP_OAUTH_STORAGE_ENCRYPTION_KEY=your-exactly-44-character-encryption-key-here

# ------------------------------------
# Cache Configuration
# ------------------------------------
# Cache backend type (redis, memory, or database)
MCP_OAUTH_STORAGE_TYPE=in-memory

# Redis connection string (format: redis://[user:password@]host:port/database)
MCP_REDIS_CONNECTION_STRING=redis://localhost:6379/0

# ------------------------------------
# Azure OAuth Authentication
# ------------------------------------
# Azure AD application client ID
# Obtain from: Azure Portal > App registrations > Your App > Application ID
AZURE_CLIENT_ID=your-client-id-here

# Azure AD application client secret
# Obtain from: Azure Portal > App registrations > Your App > Certificates & secrets
AZURE_CLIENT_SECRET=your-client-secret-here

# Azure AD tenant ID
# Obtain from: Azure Portal > Azure AD > Properties > Directory ID
AZURE_TENANT_ID=your-tenant-id-here

# ------------------------------------
# Third-party API Keys
# ------------------------------------
# AlphaVantage API key for stock market data
# Obtain from: https://www.alphavantage.co/api/
ALPHAVANTAGE_API_KEY=your-api-key-here

# OpenAI API key for language model access
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter API key for language model access
OPENROUTER_API_KEY=your-openrouter-api-key-here

